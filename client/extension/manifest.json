{
    "manifest_version": 3,
    "name": "Decision Intelligence System",
    "version": "1.0.0",
    "description": "Passively observe browser activity and capture decision-making patterns",
    "permissions": [
        "tabs",
        "webNavigation",
        "storage",
        "bookmarks",
        "history",
        "activeTab"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background/service-worker.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/content-script.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/metadata-extractor.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "assets/icon-16.png",
            "48": "assets/icon-48.png",
            "128": "assets/icon-128.png"
        }
    },
    "icons": {
        "16": "assets/icon-16.png",
        "48": "assets/icon-48.png",
        "128": "assets/icon-128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "content/*.js",
                "content/observers/*.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}